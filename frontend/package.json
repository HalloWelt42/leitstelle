{
  "name": "leitstelle-frontend",
  "private": true,
  "type": "module",
  "description": "Oberfläche der Leitstelle (Svelte 5), Gestaltung aus dem Appkern (Marken, Bausteine des Leitstands); liefert auch Schriften und Symbole für die Entwürfe",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node symbol-einbetten.mjs dist",
