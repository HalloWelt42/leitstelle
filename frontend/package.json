  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.4",
    "json-schema-to-typescript": "^16.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
