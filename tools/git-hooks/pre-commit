#!/usr/bin/env bash
# Vor jedem Commit: Version hochzählen (oder nur neue Kennung, wenn version.json schon bewusst
# geändert und vorgemerkt ist) und version.json mit vormerken. Dazu die Prüfungen des Appkerns (Zeichen, Stil,
# Marken der Gestaltung) für die vorgemerkten Dateien.
set -euo pipefail
# >>> handbuch: Seite und Einrichtungsskript prüfen (eingesetzt von "handbuch einbinden", nicht von Hand ändern)
handbuch_befehl="$(command -v handbuch || true)"
[ -n "$handbuch_befehl" ] || handbuch_befehl="$HOME/.local/bin/handbuch"
if [ ! -x "$handbuch_befehl" ]; then
  echo "Abbruch: das Werkzeug handbuch fehlt (Handbuch, Grundlage Mac)" >&2
  exit 1
fi
"$handbuch_befehl" vor-commit "$(git rev-parse --show-toplevel)" || exit 1
# <<< handbuch
HIER="$(git rev-parse --show-toplevel)"
cd "$HIER"

if git diff --cached --name-only | grep -qx 'version.json'; then
  tools/version.sh id >/dev/null
else
  tools/version.sh patch >/dev/null
fi
git add version.json

# Prüfungen des Appkerns, eine Stelle für alle eigenen Apps: nur gerade Zeichen; Stil ohne !important und ohne
# einseitige Streifen; im Stil nur Marken des Appkerns (scharf nach gestaltung.toml). Die Werkzeuge kommen mit
# backend/requirements-entwicklung.txt in die Umgebung des Backends (README, Kern prüfen).
PYTHON="$HIER/backend/.venv/bin/python"
if ! "$PYTHON" -c "import appkern.werkzeuge" 2>/dev/null; then
  echo "Abbruch: die Werkzeuge des Appkerns fehlen (cd backend && .venv/bin/pip install -r requirements-entwicklung.txt)" >&2
  exit 1
fi
dateien="$(git diff --cached --name-only --diff-filter=ACM)"
if [ -n "$dateien" ]; then
  printf '%s\n' "$dateien" | tr '\n' '\0' | xargs -0 "$PYTHON" -m appkern.werkzeuge pruefen || exit 1
fi
exit 0
